# ── Open-weight models (local Ollama) ───────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Hears each spoken turn (audio → transcript).
OLLAMA_VOICE_MODEL=gemma4:e2b
# Replies on the call, using the whole conversation as context.
OLLAMA_LISTENER_MODEL=gemma4:e4b
# Writes journal pages and answers memory questions after the call.
OLLAMA_JOURNAL_MODEL=gemma4:e4b
# Local embeddings for memory search.
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Voice (text → speech) ───────────────────────────────────────────
# Default: the local open-weight voice server in ./voice (Kokoro-82M).
VENT_TTS_BASE_URL=http://127.0.0.1:8880
VENT_TTS_VOICE=default
VENT_TTS_SPEED=1
# Optional hosted voice. Only used when VENT_VOICE_PROVIDER=elevenlabs and a key is set.
# Spoken replies (never your own voice) are then sent to ElevenLabs.
# VENT_VOICE_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Journal storage ─────────────────────────────────────────────────
# Default: a JSON file in ./.vent-data on this machine.
# VENT_DATA_DIR=.vent-data
# Optional: MongoDB Atlas (cloud or `mongodb/mongodb-atlas-local`) with Atlas Vector Search.
# MONGODB_URI=
# MONGODB_DB=vent
# VENT_EMBED_DIMENSIONS=768

# ── Observability ───────────────────────────────────────────────────
# Optional: Sentry traces of the voice pipeline (timings, models, tokens — never content).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# ── Durable journal writing ─────────────────────────────────────────
# Optional: write journal pages through a Temporal workflow (extract → embed → save,
# each step retried), so a page survives Ollama hiccups and app/worker restarts.
# Needs `temporal server start-dev` and `pnpm worker`. Unset = direct path.
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
